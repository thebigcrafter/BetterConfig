{
    "name": "kygekteam/betterconfig",
    "description": "A better YAML configuration file management virion for PocketMine-MP 5",
    "type": "library",
    "homepage": "https://poggit.pmmp.io/ci/KygekTeam/BetterConfig/~",
    "keywords": ["yaml", "poggit", "virion", "pmmp-virion", "pm5", "betterconfig"],
    "require": {
        "php": "^8.1",
        "php-64bit": "*",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "KygekTeam\\BetterConfig\\": "src/KygekTeam/BetterConfig/"
        }
    },
    "authors": [
        {
            "name": "KygekDev",
            "email": "68368066+KygekDev@users.noreply.github.com",
            "homepage": "https://kygekdev.github.io"
        }
    ],
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "KygekTeam\\BetterConfig"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist",
        "smoke": "@php tests/smoke.php"
    }
}
